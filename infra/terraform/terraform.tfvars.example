# ============================================
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in
# ============================================

aws_region       = "us-east-1"
instance_type    = "t3.medium"
ssh_allowed_ip   = "YOUR_IP_HERE/32"  # Get from: curl ifconfig.me
key_name         = "capstone-phoenix-key"
project_name     = "capstone-phoenix"