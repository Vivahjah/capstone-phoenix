# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it (contains your real IP).

region       = "us-east-1"
project_name = "capstone-phoenix"

# Your current public IP in CIDR form — changes often on mobile hotspot/dynamic
# connections. Check with: curl ifconfig.me
# Update this before every apply if it's changed since your last session.
my_ip = "0.0.0.0/32"

# Path to the local SSH public key. Terraform creates the AWS key pair from
# this file — generate one first if you don't have it:
#   ssh-keygen -t ed25519 -f ~/.ssh/capstone-phoenix-key
ssh_public_key_path = "~/.ssh/capstone-phoenix-key.pub"

server_instance_type = "t3.small"
worker_instance_type = "t3.small"